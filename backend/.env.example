# jp-tts backend configuration (all optional; shown with defaults)
# JPTTS_HOST=127.0.0.1
# JPTTS_PORT=8000
# JPTTS_ALLOW_NON_LOOPBACK=0
# JPTTS_DEVICE=auto            # auto | cuda | cpu
# JPTTS_MAX_RESIDENT_ENGINES=2
# JPTTS_VOICEVOX_ENABLED=1
# JPTTS_VOICEVOX_PORT=50021
# JPTTS_VOICEVOX_USE_GPU=1
# JPTTS_SBV2_ENABLED=1
# JPTTS_SBV2_PORT=5000
# JPTTS_GPTSOVITS_ENABLED=1
# JPTTS_GPTSOVITS_PORT=9880
# JPTTS_MAX_INTERACTIVE_CHARS=500
# JPTTS_LOG_LEVEL=INFO
